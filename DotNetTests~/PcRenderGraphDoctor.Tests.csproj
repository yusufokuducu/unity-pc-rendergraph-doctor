<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <DefineConstants>$(DefineConstants);YUSUF_DOTNET_TESTS;YUSUF_UNITY_PIPELINE_CLI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Runtime\**\*.cs" LinkBase="Runtime" />
    <Compile Include="..\Editor\**\*.cs" LinkBase="Editor" />
    <Compile Include="..\Tests\**\*.cs" LinkBase="Tests" />
  </ItemGroup>
</Project>
